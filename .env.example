# Copiá este archivo a .env en la raíz de BolsaTrabajo.
# .env contiene secretos y está excluido de Git.

# Correo saliente por Gmail (opcional si no vas a enviar emails).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Seguridad de Django. Para desarrollo local, DEBUG puede permanecer en true.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Cloudflare Tunnel: agregar el hostname exacto también a ALLOWED_HOSTS.
# Ejemplo: CSRF_TRUSTED_ORIGINS=https://bolsa.example.com
CSRF_TRUSTED_ORIGINS=
# true solo si el servidor escucha en loopback detrás de un proxy confiable.
# En producción se confía en X-Forwarded-Proto por defecto.
# TRUST_PROXY_HEADERS=true
# En producción usá HTTPS y configurá el proxy para enviar X-Forwarded-Proto.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# Base de datos: SQLite por defecto en desarrollo.
# Para PostgreSQL, cambiá DB_ENGINE y completá las variables DB_*.
# En producción DEBUG=false exige PostgreSQL; no copies contraseñas reales a Git.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
# En desarrollo puede quedar vacío (sslmode=prefer). En producción se exige
# cifrado por defecto (sslmode=require); usá verify-full si tu proveedor da CA.
DB_SSLMODE=

# Endpoint POST del microservicio FastAPI para recibir CV en PDF.
IA_API_URL=http://127.0.0.1:8001/api/v1/cv-analyses

# Endpoint JSON para analizar una oferta publicada.
IA_OFFER_API_URL=http://127.0.0.1:8001/api/v1/offer-analyses

# Token Bearer saliente. Debe coincidir con SERVICE_API_TOKEN de FastAPI.
IA_API_TOKEN=

# Secreto compartido para autenticar el callback de FastAPI hacia Django.
# Generá uno propio y copiá el MISMO valor a CV_RESULT_CALLBACK_SECRET en ia_api/backend/.env.
IA_CALLBACK_TOKEN=

# Secreto HMAC para callbacks. Debe coincidir con CV_RESULT_CALLBACK_HMAC_SECRET.
IA_CALLBACK_HMAC_SECRET=

# Reservado para una URL pública fija del callback. El flujo actual no lo usa.
IA_CALLBACK_URL=

# Redis para Channels, caché de match y los procesos de despacho.
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/3
MATCH_CACHE_REDIS_URL=redis://127.0.0.1:6379/6
MATCH_CACHE_TTL_SECONDS=604800
MATCH_REQUESTS_PER_HOUR=20

# Compatibilidad en la misma API de CV. MATCH_API_TOKEN debe coincidir con IA_API_TOKEN.
# El navegador no recibe este token.
MATCH_API_URL=ws://127.0.0.1:8001/api/v1/ws/v1/matches
MATCH_API_HTTP_URL=http://127.0.0.1:8001/api/v1
MATCH_API_TOKEN=
MATCH_MODEL_VERSION=groq:qwen/qwen3.8-27b:strict-low

# Completar con la dirección institucional confirmada para los enlaces de contacto.
IEN_CONTACT_EMAIL=
