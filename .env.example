# Copiar a BolsaTrabajo/.env. Guía de cada valor: README.md, sección Configuración.
# Ejemplo local; no contiene secretos ni configura una VPS automáticamente.

# Generar SECRET_KEY. Las claves de Gemini y Groq se guardan solo en la API.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_HEADERS=false
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# SQLite local. VPS: postgresql y completar DB_*; ver README.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=

# API única en 8001: rutas internas, no claves externas.
IA_API_URL=http://127.0.0.1:8001/api/v1/cv-analyses
IA_OFFER_API_URL=http://127.0.0.1:8001/api/v1/offer-analyses
MATCH_API_URL=ws://127.0.0.1:8001/api/v1/ws/v1/matches
MATCH_API_HTTP_URL=http://127.0.0.1:8001/api/v1
# Generar UN token y copiarlo en ambas variables y SERVICE_API_TOKEN de la API.
IA_API_TOKEN=
MATCH_API_TOKEN=
# Generar OTRO secreto; mismo CV_RESULT_CALLBACK_HMAC_SECRET de la API.
IA_CALLBACK_HMAC_SECRET=
# Etiqueta de caché: alinear con proveedor/modelo de match de la API.
MATCH_MODEL_VERSION=groq:qwen/qwen3.8-27b:strict-low

# CHANNEL_REDIS_URL debe coincidir en los dos repositorios.
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/3
MATCH_CACHE_REDIS_URL=redis://127.0.0.1:6379/6
MATCH_CACHE_TTL_SECONDS=604800
MATCH_REQUESTS_PER_HOUR=20

# SMTP Gmail: contraseña de aplicación, no contraseña de la cuenta.
# Pruebas sin envío: django.core.mail.backends.console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Vacío usa EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=
# Dirección institucional confirmada para contacto; no es un secreto.
IEN_CONTACT_EMAIL=

# Opcional DOC/RTF: imagen vacía hasta instalar el conversor aislado.
CV_LEGACY_CONVERTER_IMAGE=
CV_DOCKER_COMMAND=docker
CV_LEGACY_CONVERSION_TIMEOUT_SECONDS=30
