# Copiar a .env.ia-demo en la raíz. No usar CV reales en la demostración.
SERVICE_API_TOKEN=
CV_RESULT_CALLBACK_URL=https://ien-bolsa-demo.onrender.com/ia/llegue/
CV_RESULT_CALLBACK_HMAC_SECRET=
GROQ_API_KEY=
LLM_PROVIDER=groq
MATCH_PROVIDER=groq
CV_MODEL=qwen/qwen3.8-27b
MATCH_GROQ_MODEL=qwen/qwen3.8-27b
# Evita cientos de solicitudes pequeñas en una demostración con cuota Free.
CV_PACKET_CHARACTERS=20000
CV_BLOQUE_CARACTERES=20000
CV_EXTRACTION_MAX_TOKENS=6000
# RAG vectorial opcional: vacío usa el catálogo léxico incluido, sin embeddings.
SKILL_CATALOG_DATABASE_URL=
