# Referencia para Render > Environment. No guardar valores reales en Git.
DJANGO_SETTINGS_MODULE=ientrabajo.settings.render
DEBUG=false
SECRET_KEY=generar-un-secreto-largo-y-aleatorio
DB_ENGINE=postgresql
ALLOWED_HOSTS=ien-bolsa-demo.onrender.com
CSRF_TRUSTED_ORIGINS=https://ien-bolsa-demo.onrender.com
DATABASE_URL=postgresql://usuario:clave@host-pooler.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require&channel_binding=require
AWS_ENDPOINT_URL_S3=https://copiar-endpoint-de-storage-de-neon
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=ien-demo-privado
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Render inyecta ambas desde el Key Value Free. También pueden compartir DB 0:
# las claves de Channels y del match tienen nombres distintos.
CHANNEL_REDIS_URL=redis://copiar-url-interna-render:6379
MATCH_CACHE_REDIS_URL=redis://copiar-url-interna-render:6379
IA_API_URL=https://copiar-tunel.trycloudflare.com/api/v1/cv-analyses
IA_OFFER_API_URL=https://copiar-tunel.trycloudflare.com/api/v1/offer-analyses
IA_API_TOKEN=
IA_CALLBACK_HMAC_SECRET=
MATCH_API_URL=wss://copiar-tunel.trycloudflare.com/api/v1/ws/v1/matches
MATCH_API_HTTP_URL=https://copiar-tunel.trycloudflare.com/api/v1
MATCH_API_TOKEN=
MATCH_MODEL_VERSION=groq:qwen/qwen3.8-27b:strict-low
EMAIL_BACKEND=ientrabajo.email_backends.BrevoEmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
IEN_CONTACT_EMAIL=
