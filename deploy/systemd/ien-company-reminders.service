[Unit]
Description=IEN company approval email reminders
After=network-online.target postgresql.service ien-django.service
Wants=network-online.target

[Service]
Type=simple
User=ienapp
Group=ienapp
WorkingDirectory=/srv/ien/BolsaTrabajo
ExecStart=/srv/ien/BolsaTrabajo/.venv/bin/python -u manage.py run_integration_dispatcher --kind company-reminders --interval 60
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
