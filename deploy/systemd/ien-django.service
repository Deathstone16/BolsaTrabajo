[Unit]
Description=IEN Bolsa Django ASGI
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=ienapp
Group=ienapp
WorkingDirectory=/srv/ien/BolsaTrabajo
ExecStart=/srv/ien/BolsaTrabajo/.venv/bin/daphne -b 127.0.0.1 -p 8000 ientrabajo.asgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
